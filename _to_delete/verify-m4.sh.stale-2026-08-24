#!/usr/bin/env bash
# verify-m4.sh — independently check what M4 actually does and does not do.
set -uo pipefail

ROOT="${1:-$HOME/Block}"
cd "$ROOT" || { echo "cannot cd to $ROOT"; exit 2; }

pass=0; fail=0
ok()   { echo "  PASS  $1"; pass=$((pass+1)); }
bad()  { echo "  FAIL  $1"; fail=$((fail+1)); }
note() { echo "  --    $1"; }

echo "=============================================="
echo " 1. DOES IT BUILD AND PASS ITS OWN TESTS?"
echo "=============================================="
if (cd avc && go build ./... >/dev/null 2>&1); then ok "avc builds"; else bad "avc build"; fi
if (cd jmdn && go build ./... >/dev/null 2>&1); then ok "jmdn builds"; else bad "jmdn build"; fi
if (cd avc && go test ./randao/ >/dev/null 2>&1); then ok "avc/randao tests"; else bad "avc/randao tests"; fi
if (cd jmdn && go test ./messaging/ >/dev/null 2>&1); then ok "jmdn/messaging tests"; else bad "jmdn/messaging tests"; fi
echo
echo "  Test counts actually executed:"
(cd avc && go test ./randao/ -v 2>/dev/null | grep -c '^--- PASS' | sed 's/^/    avc\/randao  passing: /')
(cd jmdn && go test ./messaging/ -v 2>/dev/null | grep -c '^--- PASS' | sed 's/^/    messaging   passing: /')

echo
echo "=============================================="
echo " 2. IS THE HAPPY PATH ACTUALLY CONNECTED?"
echo "    (a reveal must travel: produce -> block -> fold -> finalise -> VDF)"
echo "=============================================="
callers() { grep -rn "\b$1(" --include=\*.go jmdn avc 2>/dev/null | grep -v '_test.go' | grep -v "func $1" | wc -l | tr -d ' '; }

n=$(callers SetBeaconSource);          [ "$n" -gt 0 ] && ok  "Stage A/F: SetBeaconSource has $n caller(s)"   || bad "Stage A/F: SetBeaconSource has NO caller"
n=$(callers SetEpochFinalisedHook);    [ "$n" -gt 0 ] && ok  "Stage E: SetEpochFinalisedHook has $n caller(s)" || bad "Stage E: SetEpochFinalisedHook has NO caller"
n=$(callers foldBlockDeclaredReveals); [ "$n" -gt 0 ] && ok  "Stage C: fold hook has $n call site(s)"        || bad "Stage C: fold hook NOT called"
n=$(callers maybeFinaliseCompletedEpochs); [ "$n" -gt 0 ] && ok "Stage D: finalise hook has $n call site(s)" || bad "Stage D: finalise hook NOT called"

n=$(callers SetNodeIdentity)
if [ "$n" -gt 0 ]; then ok "reveal signing key installed at startup ($n caller)"; else bad "NOTHING calls SetNodeIdentity -> this node can never sign a reveal"; fi
n=$(callers ProduceRevealForEpoch)
if [ "$n" -gt 0 ]; then ok "reveal is produced ($n caller)"; else bad "NOTHING calls ProduceRevealForEpoch -> no reveal is ever created"; fi

echo
echo "  The decisive one — does any code put a reveal INTO a block?"
w=$(grep -rn 'block.RandaoReveals = ' --include=\*.go jmdn 2>/dev/null | grep -v '_test.go' | wc -l | tr -d ' ')
if [ "$w" -gt 0 ]; then ok "something assigns block.RandaoReveals ($w site(s))"
else bad "NOTHING assigns block.RandaoReveals -> every block ships empty -> the fold never runs"; fi

echo
echo "=============================================="
echo " 3. WHAT HAPPENS TODAY IF AN EPOCH FINALISES?"
echo "=============================================="
n=$(callers RecordAggSigForFallback)
if [ "$n" -gt 0 ]; then ok "aggSig collector is fed ($n caller) -> B1 code path exists"
else bad "aggSig collector has NO caller (blocker B1) -> the fallback CANNOT compute"; fi
n=$(callers VerifyAndRecordPrevCert)
if [ "$n" -gt 0 ]; then ok "parent certificate is verified on commit ($n hook(s))"; else bad "nothing verifies the parent certificate"; fi
n=$(callers RecordCommitCertificate)
if [ "$n" -gt 0 ]; then ok "sequencer stashes the commit certificate ($n caller)"; else bad "nothing stashes the commit certificate"; fi

# Regression guards for the 2026-08-24 count-based collection / two-phase
# finalisation amendment: the fixed [K,K+B) window previously made the
# fallback fold permanently uncomputable on a single timeout, AND
# maybeFinaliseCompletedEpochs called the fold at the exact instant its
# window held zero data. Both are fixed; these checks catch either regressing.
n=$(grep -rn 'func resolvePendingFallbacks' --include=\*.go jmdn/messaging 2>/dev/null | wc -l | tr -d ' ')
if [ "$n" -gt 0 ]; then ok "two-phase fallback finalisation present (decideEpoch/resolvePendingFallbacks)"
else bad "still single-shot finalisation -- the 'fallback can never succeed' bug is back"; fi
if grep -q 'FallbackFoldMaxSlotOffset' jmdn/messaging/entropy_fallback_window.go 2>/dev/null; then
  ok "fallback collection has a separate slot deadline, distinct from B"
else bad "no slot deadline constant found -- B may have been collapsed back into a slot boundary"; fi
if grep -q 'func FallbackCollectionBounds' avc/randao/fallback_aggsig.go 2>/dev/null; then
  ok "avc/randao exposes count-tolerant collection bounds"
else bad "avc/randao still has only the old fixed-width FallbackWindow"; fi
if grep -q 'func FallbackWindow\b' avc/randao/fallback_aggsig.go 2>/dev/null; then
  bad "the old fixed-width FallbackWindow is BACK -- a caller may have regressed to it"
else ok "old fixed-width FallbackWindow is gone"; fi
if grep -q 'PrevAggCert' jmdn/config/ZKBlock.go 2>/dev/null; then ok "ZKBlock carries PrevAggCert (B1 wire field present)"; else bad "ZKBlock has no certificate field"; fi
if grep -q 'EncodeCertSigners' jmdn/Security/consensus_fields_hash.go 2>/dev/null; then ok "PrevAggCert is hash-covered under M2b"; else bad "PrevAggCert is NOT hash-covered"; fi
if grep -q 'JMDN_AVC_AGG_CERT' jmdn/messaging/entropy_aggsig.go 2>/dev/null; then note "B1 path is behind JMDN_AVC_AGG_CERT (default OFF) — coordinated rollout, like M2b"; fi
# Passed as a function VALUE to SetStreamHandler, so it has no trailing "(" —
# grep for the registration itself rather than for a call.
n=$(grep -rn 'SetStreamHandler(config.RevealPushProtocol' --include=\*.go jmdn 2>/dev/null | grep -v '_test.go' | wc -l | tr -d ' ')
if [ "$n" -gt 0 ]; then ok "RevealPush receive handler registered ($n site(s))"; else bad "RevealPush handler NOT registered"; fi
n=$(callers PushOwnRevealForSlot)
if [ "$n" -gt 0 ]; then ok "RevealPush is sent per slot ($n caller)"; else bad "nothing sends RevealPush"; fi

# Regression guards for the 2026-08-24 restart-recovery work
# (docs/COMMITTEE-SNAPSHOT-FREEZE-TODO.md items 1, 6, 8): slot survives a
# restart, and the entropy-committee snapshot's hash is anchored on-chain.
if grep -q 'func (s \*SlotStore) SeedFromCommittedTip' jmdn/messaging/slot_store.go 2>/dev/null; then
  ok "SlotStore can be reseeded from a synced tip block after a restart"
else bad "SlotStore has no restart-reseed path -- slot resets to 0 on every restart"; fi
if grep -q 'ExtraData\["slot"\]' jmdn/DB_OPs/backend/block.go 2>/dev/null; then
  ok "Slot/Period are persisted into the block record (reseed has something to read)"
else bad "Slot/Period are NOT persisted -- SeedFromCommittedTip has nothing to reseed from"; fi
if grep -q 'func HashSnapshot' avc/committee/snapshot_hash.go 2>/dev/null; then
  ok "avc/committee exposes a canonical, deterministic snapshot hash"
else bad "avc/committee has no snapshot-hashing function"; fi
if grep -q 'CommitteeSnapshotHash' jmdn/config/ZKBlock.go 2>/dev/null; then
  ok "ZKBlock carries CommitteeSnapshotHash (on-chain anchor field present)"
else bad "ZKBlock has no field to anchor the snapshot hash"; fi
if grep -q 'CommitteeSnapshotHash' jmdn/Security/consensus_fields_hash.go 2>/dev/null; then
  ok "CommitteeSnapshotHash is hash-covered under M2b v2"
else bad "CommitteeSnapshotHash is NOT hash-covered -- a relay could rewrite it post-commit"; fi
if grep -q 'JMDN_COMMITTEE_SNAPSHOT_ANCHOR' jmdn/messaging/committee_snapshot_anchor.go 2>/dev/null; then
  note "snapshot-anchor path is behind JMDN_COMMITTEE_SNAPSHOT_ANCHOR (default OFF) — coordinated rollout, like M2b"
fi
n=$(callers maybeFreezeUpcomingSnapshot)
if [ "$n" -gt 0 ]; then ok "snapshot freeze trigger is wired into the commit path ($n caller)"; else bad "maybeFreezeUpcomingSnapshot is never called"; fi

echo
# The grindable interim state-root fallback was DELETED 2026-08-20. These are
# regression guards: if any of them fails, a weaker fallback has come back.
if grep -rq 'FallbackWithStateRoot' --include=\*.go jmdn avc 2>/dev/null; then
  bad "the interim state-root fallback formula is BACK in the tree"
else ok "interim state-root fallback formula is gone from both repos"; fi
if grep -rq 'JMDN_ALLOW_INTERIM_STATEROOT_FALLBACK' --include=\*.go jmdn 2>/dev/null; then
  bad "the interim-fallback env-var escape hatch is BACK"
else ok "no env var can select a weaker fallback -- §4.2a's fold or fail closed, nothing else"; fi
if [ -f jmdn/messaging/state_root_fallback.go ] || [ -f avc/randao/fallback_interim_stateroot.go ]; then
  bad "a deleted interim-fallback file has reappeared"
else ok "both interim-fallback files remain deleted"; fi

echo
echo "=============================================="
echo " 4. CLAIMS I MADE THAT YOU SHOULD SPOT-CHECK"
echo "=============================================="
if grep -q 'proof.T != p.difficulty' avc/beacon/beacon.go 2>/dev/null; then
  ok "beacon.Accept DOES check proof difficulty (my earlier 'missing' finding was wrong)"
else bad "beacon.Accept does not check proof.T — my correction was itself wrong, tell me"; fi

if grep -A6 'func CheckDelay' avc/vdf/vdf.go 2>/dev/null | grep -q 'revealWindow/2'; then
  ok "CheckDelay still has no S term (claim stands: it does NOT enforce bias-resistance)"
else note "CheckDelay changed — re-verify"; fi

if grep -q 'haveCommitted && height <= s.lastCommittedHeight' jmdn/messaging/slot_store.go 2>/dev/null; then
  note "SlotStore's own duplicate-commit guard is unchanged (expected — the fix below is a separate startup/gate layer, not a rewrite of this line)"
else note "slot_store changed — re-verify"; fi

echo
# Regression guards for the 2026-08-24 SLOT-RESTART FAIL-CLOSED RECOVERY fix
# (docs/COMMITTEE-SNAPSHOT-FREEZE-TODO.md item 8's remaining integration
# step): the finding "SlotStore can restart at slot 0 and treat the next
# commit as the first-ever commit ... no fail-closed guard" is now CLOSED,
# not open — superseding the stale "claim stands" check this replaced.
if grep -q 'func RecoverSlotStoreAtStartup' jmdn/messaging/slot_store_recovery.go 2>/dev/null; then
  ok "slot recovery function exists (RecoverSlotStoreAtStartup)"
else bad "RecoverSlotStoreAtStartup is missing -- slot recovery not present"; fi
if grep -q 'func EnsureSlotStoreRecovered' jmdn/messaging/slot_store_recovery.go 2>/dev/null; then
  ok "idempotent re-recovery function exists (EnsureSlotStoreRecovered) — for the fast-sync/rejoin path"
else bad "EnsureSlotStoreRecovered is missing -- fast-sync catch-up would never re-seed SlotStore"; fi
n=$(callers RecoverSlotStoreAtStartup)
if [ "$n" -gt 0 ]; then ok "RecoverSlotStoreAtStartup is called from real startup ($n caller)"; else bad "RecoverSlotStoreAtStartup is never called -- still dead code"; fi
n=$(callers EnsureSlotStoreRecovered)
if [ "$n" -gt 0 ]; then ok "EnsureSlotStoreRecovered is called from the fast-sync reconcile path ($n caller)"; else bad "EnsureSlotStoreRecovered is never called -- fast-sync catch-up would not re-seed SlotStore"; fi
if grep -q 'slotStoreReadyFn != nil && !slotStoreReadyFn()' jmdn/AVC/BuddyNodes/MessagePassing/consensus_sync_gate.go 2>/dev/null; then
  ok "vote path fails closed on an unrecovered SlotStore (consensusVoteReady)"
else bad "vote path does NOT check slot-recovery readiness -- a restarted node could still vote at slot 0"; fi
if grep -q 'EnforceSlotRecoveryGate && !messaging.SlotStoreReady()' jmdn/Block/consensus_fields.go 2>/dev/null; then
  ok "propose path fails closed on an unrecovered SlotStore (attachAVCConsensusFields)"
else bad "propose path does NOT check slot-recovery readiness -- a restarted node could still propose at slot 0"; fi
if grep -q 'SetSlotStoreReadyFn(messaging.SlotStoreReady)' jmdn/main.go 2>/dev/null; then
  ok "vote-gate readiness fn is wired to messaging.SlotStoreReady at real startup"
else bad "MessagePassing.SetSlotStoreReadyFn is never wired in main.go -- vote gate always permits"; fi
if grep -q 'r.ExtraData\["slot"\]' jmdn/DB_OPs/thebe_conversions.go 2>/dev/null; then
  ok "read-side conversion (blockRecordToZKBlock) decodes slot/period back out of ExtraData"
else bad "blockRecordToZKBlock does not decode slot/period -- GetZKBlockByNumber would always see Slot=0/Period=0, defeating recovery"; fi

echo
# Regression guards for the 2026-08-24 timeout-certificate END-TO-END WIRING
# (M0/§7.1c): timeout detected -> vote -> gossip -> tally -> certificate ->
# gossip -> accept -> PeriodStore. Before this work, every function in
# timeout_certificates.go had zero non-test callers anywhere.
if grep -q 'func MaybeStartTimeoutFlow' jmdn/messaging/timeout_gossip.go 2>/dev/null; then
  ok "timeout-certificate live wiring exists (MaybeStartTimeoutFlow)"
else bad "MaybeStartTimeoutFlow is missing -- timeout wiring not present"; fi
n=$(callers MaybeStartTimeoutFlow)
if [ "$n" -gt 0 ]; then ok "MaybeStartTimeoutFlow is called from live consensus ($n caller)"; else bad "MaybeStartTimeoutFlow is never called -- still dead code"; fi
n=$(callers SignTimeoutVote)
if [ "$n" -gt 0 ]; then ok "SignTimeoutVote has a live (non-test) caller ($n)"; else bad "SignTimeoutVote is still never called outside tests"; fi
n=$(callers TallyTimeoutVotes)
if [ "$n" -gt 0 ]; then ok "TallyTimeoutVotes has a live caller ($n)"; else bad "TallyTimeoutVotes is still never called outside tests"; fi
n=$(callers AcceptTimeoutCertificate)
if [ "$n" -gt 0 ]; then ok "PeriodStore.AcceptTimeoutCertificate has a live caller ($n)"; else bad "AcceptTimeoutCertificate is still never called outside tests"; fi
n=$(grep -rn '"timeout_vote"\|timeoutVoteBroadcastType' --include=\*.go jmdn/messaging 2>/dev/null | grep -v _test.go | wc -l | tr -d ' ')
if [ "$n" -gt 1 ]; then ok "a TimeoutVote gossip message type exists and is dispatched ($n site(s))"; else bad "no TimeoutVote gossip message type wired into HandleBroadcastStream"; fi
n=$(grep -rn '"timeout_certificate"\|timeoutCertBroadcastType' --include=\*.go jmdn/messaging 2>/dev/null | grep -v _test.go | wc -l | tr -d ' ')
if [ "$n" -gt 1 ]; then ok "a TimeoutCertificate gossip message type exists and is dispatched ($n site(s))"; else bad "no TimeoutCertificate gossip message type wired into HandleBroadcastStream"; fi
if grep -q 'func LatestTimeoutCertificateFor' jmdn/messaging/timeout_gossip.go 2>/dev/null; then
  ok "a rejoining node can query the latest accepted certificate without replay (LatestTimeoutCertificateFor)"
else bad "no catch-up primitive for a rejoining node -- point 9 of the wiring request is unaddressed"; fi
n=$(grep -rn 'blockVoters\[' jmdn/Sequencer/consensus_statemachine.go 2>/dev/null | wc -l | tr -d ' ')
if [ "$n" -gt 0 ]; then ok "block-vote peer set is threaded into the timeout flow (mutual exclusion, §7.1b)"; else bad "timeout flow has no block-vote set -- equivocation exclusion cannot work"; fi
note "SCOPE: the rejoin/catch-up TRANSPORT (an RPC to ASK a peer for the latest cert) is still a TODO -- LatestTimeoutCertificateFor is the primitive it would call, same precedent as the seed-node GetCommitteeSnapshot gap."
note "timeout wiring is behind JMDN_TIMEOUT_CERT_WIRING (default OFF) — same coordinated rollout discipline as M2b / JMDN_COMMITTEE_SNAPSHOT_ANCHOR."

echo
echo "  B ceiling arithmetic, recomputed here rather than quoted:"
python3 - <<'PY' 2>/dev/null || echo "    (python3 unavailable — skip)"
N,K,s,T = 50,3,60,1200
B = 5
print(f"    liveness ceiling on T_vdf at B={B}: (N-K-B)/2*s = {(N-K-B)/2*s:.0f}s ; T_vdf={T}s -> {'OK' if T <= (N-K-B)/2*s else 'FAIL'}")
maxB = max(b for b in range(1,20) if T <= (N-K-b)/2*s)
print(f"    max B satisfying it: {maxB}")
print(f"    bias floor at S=6.67 : {6.67*K*s:.2f}s vs T_vdf={T}s -> {'OK' if T >= 6.67*K*s else 'FAILS by %.2fs' % (6.67*K*s-T)}")
print(f"    bias floor at S=20/3 : {20/3*K*s:.2f}s vs T_vdf={T}s -> {'OK' if T >= 20/3*K*s else 'FAIL'}")
PY

echo
echo "=============================================="
printf " checks passed: %s   failed: %s\n" "$pass" "$fail"
echo " A FAIL above is information, not necessarily a defect —"
echo " several are the known-unbuilt seams. Read them against the status table."
echo "=============================================="
